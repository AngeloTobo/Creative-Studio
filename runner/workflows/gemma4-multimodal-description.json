{
  "1": {
    "inputs": {
      "prompt": "Describe this uploaded media as a detailed, reusable generation prompt.",
      "max_length": 2048,
      "sampling_mode": "on",
      "sampling_mode.temperature": 0.7,
      "sampling_mode.top_k": 64,
      "sampling_mode.top_p": 0.95,
      "sampling_mode.min_p": 0.05,
      "sampling_mode.repetition_penalty": 1.05,
      "sampling_mode.seed": 0,
      "sampling_mode.presence_penalty": 0,
      "thinking": false,
      "use_default_template": true,
      "clip": ["3", 0],
      "image": ["2", 0]
    },
    "class_type": "TextGenerate",
    "_meta": { "title": "Generate detailed media description" }
  },
  "2": {
    "inputs": { "image": "source.png" },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Image" }
  },
  "3": {
    "inputs": {
      "clip_name": "gemma4_e4b_it_fp8_scaled.safetensors",
      "type": "stable_diffusion",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Gemma 4" }
  },
  "4": {
    "inputs": { "source": ["1", 0] },
    "class_type": "PreviewAny",
    "_meta": { "title": "Retain detailed description" }
  },
  "5": {
    "inputs": { "audio": "source.mp3" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Load Audio" }
  },
  "6": {
    "inputs": { "file": "source.mp4" },
    "class_type": "LoadVideo",
    "_meta": { "title": "Load Video" }
  },
  "7": {
    "inputs": { "video": ["6", 0] },
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Get Video Components" }
  }
}
